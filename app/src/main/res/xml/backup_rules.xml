<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- 允许备份常规 SharedPreferences -->
    <include domain="sharedpref" path="."/>
    <!-- 排除敏感数据：GitHub token、API key -->
    <exclude domain="sharedpref" path="github_prefs.xml"/>
    <exclude domain="sharedpref" path="codex_prefs.xml"/>
    <exclude domain="sharedpref" path="codex_capability_prefs.xml"/>
    <exclude domain="sharedpref" path="codex_setup_prefs.xml"/>
    <!-- 排除 rootfs 和 agent 二进制（体积大，可重新下载） -->
    <exclude domain="file" path="linux-rootfs/"/>
    <exclude domain="file" path="agent-binaries/"/>
</full-backup-content>
